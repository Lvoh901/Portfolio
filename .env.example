# Production environment for the deployed API + dashboard.
# Values are pulled locally by `neon deploy` into .env.local; on the host, set
# each name below in the service's environment settings. Never commit values.

# --- Postgres (production branch) -------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Managed Better Auth ----------------------------------------------------
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# --- Object storage (private `uploads` bucket) ------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# UPLOADS_BUCKET=uploads

# --- Realtime (dashboard inbox live query) ----------------------------------
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# --- Local dev only (optional in production) --------------------------------
# The deployed app reads these from /runtime-config.js, which the API serves.
# Only needed for `vite dev` or a static-only build without the API.
VITE_NEON_AUTH_URL=
VITE_NEON_REALTIME_URL=

# --- Optional ---------------------------------------------------------------
# Only used to seed admin_users on an empty database; the Access tab owns the
# list afterwards.
# ADMIN_EMAILS=you@example.com
# PORT is provided by the host.
