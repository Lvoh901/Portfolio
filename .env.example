# Production environment for the Next.js app.
# Locally these come from `neon deploy` in .env.local; on the host, set each
# name in the service's environment settings. Never commit values.

# --- Postgres (production branch) -------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Managed Better Auth ----------------------------------------------------
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Inlined into the browser bundle at build time.
NEXT_PUBLIC_NEON_AUTH_URL=

# --- Realtime (dashboard inbox live query) ----------------------------------
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Inlined into the browser bundle at build time.
NEXT_PUBLIC_NEON_REALTIME_URL=

# --- Uploads (UploadThing: CV + project images) -----------------------------
# Create an app at https://uploadthing.com/dashboard and copy its token.
UPLOADTHING_TOKEN=

# --- Optional ---------------------------------------------------------------
# Only used to seed admin_users on an empty database; the Access tab owns the
# list afterwards.
# ADMIN_EMAILS=you@example.com
# PORT is provided by the host.
